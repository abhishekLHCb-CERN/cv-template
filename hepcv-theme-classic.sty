%% hepcv-theme-classic.sty : refined editorial theme (LuaLaTeX or XeLaTeX only; needs fontspec through
%% hepcv-fonts-classic.sty, which hepcv.cls loads for theme=classic).
%% Look: Source Sans Pro Light body, indigo accent, name with small-caps surname, FontAwesome 5 icons,
%% optional circular photo, right-aligned date gutter with a hairline rule, rounded grey keyword tags,
%% small-caps footer (date | name | page).  Class options: ats=true|false icons=true|false photo=<file>
%% photosize=<dim, the true diameter>.  With ats=true icons, photo and tag graphics are dropped and the
%% layout is linear text (reading order for applicant-tracking systems).  MIT licence.
\RequirePackage{expl3}
\ProvidesExplPackage{hepcv-theme-classic}{2026/11/25}{1.0}{hepcv classic theme}
\RequirePackage{iftex}
\sys_if_engine_pdftex:T { \msg_fatal:nn { hepcv } { needlua } }
\RequirePackage{graphicx,tikz,accsupp}
\RequirePackage{fontawesome5}
\bool_if:NT \g_hepcv_ats_bool { \bool_gset_false:N \g_hepcv_icons_bool \tl_gclear:N \g_hepcv_photo_tl }

%% ---------------------------------------------------------------- colours and density
\definecolor{cvaccent}{HTML}{34218A}   % indigo
\definecolor{cvtext}{HTML}{1F1F26}
\definecolor{cvgrey}{HTML}{4B4B57}
\definecolor{cvrule}{HTML}{C9C6DA}
\definecolor{cvtagline}{HTML}{BDBDC8}
\definecolor{cvtagfill}{HTML}{F2F2F6}
\AtBeginDocument { \color{cvtext} \hypersetup { colorlinks = true , urlcolor = cvaccent , linkcolor = cvaccent } }
\geometry { top = 15mm , bottom = 21mm , left = 17mm , right = 17mm , footskip = 10mm }
%% linear (ATS) layout is full width: narrower measure, 21.5 mm side margins (about 94 characters per line)
\bool_if:NT \g_hepcv_ats_bool { \geometry { left = 21.5mm , right = 21.5mm } }
\dim_set:Nn \l_hepcv_secbefore_dim { 15pt }
\dim_set:Nn \l_hepcv_secafter_dim  { 6pt }
\dim_set:Nn \l_hepcv_entrysep_dim  { 7pt }
\dim_set:Nn \l_hepcv_itemsep_dim   { 2pt }
\dim_set:Nn \l_hepcv_linesep_dim { 3pt }
\linespread{1.14}
\setlength{\emergencystretch}{3em}
\dim_new:N \l_hepcv_gutter_dim   \dim_set:Nn \l_hepcv_gutter_dim { 27mm }
\dim_new:N \l_hepcv_gutgap_dim   \dim_set:Nn \l_hepcv_gutgap_dim { 3.2mm }
\dim_new:N \l__hepcv_cl_bodyw_dim
\dim_set:Nn \l__hepcv_cl_bodyw_dim { \linewidth - \l_hepcv_gutter_dim - 2 \l_hepcv_gutgap_dim - 0.5pt }
\dim_new:N \l__hepcv_cl_indent_dim
\dim_set:Nn \l__hepcv_cl_indent_dim { \l_hepcv_gutter_dim + 2 \l_hepcv_gutgap_dim + 0.5pt }
\AtBeginDocument
  {
    \dim_set:Nn \l__hepcv_cl_bodyw_dim { \linewidth - \l_hepcv_gutter_dim - 2 \l_hepcv_gutgap_dim - 0.5pt }
    \cs_if_exist:NT \cvpubindent { \bool_if:NF \g_hepcv_ats_bool { \setlength \cvpubindent { \l__hepcv_cl_indent_dim } } }
  }

%% ---------------------------------------------------------------- icons (decorative: empty ActualText)
\cs_new_protected:Npn \hepcv_cl_icon:n #1
  {
    \bool_if:NT \g_hepcv_icons_bool
      { \BeginAccSupp { ActualText = } {\color{cvaccent}#1} \EndAccSupp { } }
  }
\prop_new:N \g_hepcv_cl_secicon_prop
\prop_gset_from_keyval:Nn \g_hepcv_cl_secicon_prop
  {
    profile = \faUserTie , summary = \faUserTie , education = \faGraduationCap , experience = \faBriefcase ,
    research~experience = \faFlask , positions = \faBriefcase , skills = \faWrench , technical~skills = \faWrench ,
    publications = \faBookOpen , talks = \faMicrophone , grants = \faCoins , teaching = \faChalkboardTeacher ,
    awards = \faAward , service = \faHandsHelping , referees = \faUserFriends , references = \faUserFriends
  }
\NewDocumentCommand \cvsectionicon { m m }
  { \prop_gput:Nxn \g_hepcv_cl_secicon_prop { \str_foldcase:n {#1} } {#2} }
\cs_new_protected:Npn \hepcv_cl_secicon:n #1
  {
    \prop_get:NxNTF \g_hepcv_cl_secicon_prop { \str_foldcase:n {#1} } \l_tmpa_tl
      { \hepcv_cl_icon:n { \l_tmpa_tl } }
      { \hepcv_cl_icon:n { \faAngleRight } }
  }
\cs_new_protected:Npn \hepcv_cl_contact_icon:n #1
  {
    \str_case:enF { \str_foldcase:n {#1} }
      {
        { email } { \faAt } { e-mail } { \faAt } { phone } { \faPhone } { mobile } { \faPhone }
        { location } { \faMapMarker* } { address } { \faMapMarker* } { orcid } { \faOrcid }
        { inspire } { \faAtom } { github } { \faGithub } { linkedin } { \faLinkedin }
        { web } { \faGlobe } { website } { \faGlobe } { homepage } { \faGlobe } { scholar } { \faGraduationCap }
      }
      { \faLink }
  }

%% ---------------------------------------------------------------- name, header, photo
\seq_new:N \l__hepcv_cl_name_seq
\tl_new:N \l__hepcv_cl_first_tl
\tl_new:N \l__hepcv_cl_last_tl
\cs_new_protected:Npn \hepcv_cl_name:
  {
    \seq_set_split:NnV \l__hepcv_cl_name_seq { ~ } \g_hepcv_name_tl
    \int_compare:nTF { \seq_count:N \l__hepcv_cl_name_seq > 1 }
      {
        \seq_pop_right:NN \l__hepcv_cl_name_seq \l__hepcv_cl_last_tl
        \tl_set:Nx \l__hepcv_cl_first_tl { \seq_use:Nn \l__hepcv_cl_name_seq { ~ } }
        \hepcv_actualx:nn { \exp_not:V \g_hepcv_name_tl } { \l__hepcv_cl_first_tl \nobreakspace {\cvmedium\textsc{\l__hepcv_cl_last_tl}} }
      }
      { \tl_use:N \g_hepcv_name_tl }
  }
\ExplSyntaxOff
\newcommand*\hepcv@cl@photo[2]{%
  \sbox\z@{\includegraphics{#2}}%
  \dimen@=\ifdim\wd\z@<\ht\z@ \wd\z@\else\ht\z@\fi
  \edef\hepcv@cl@scale{\strip@pt\dimexpr #1*65536/\dimen@\relax}%
  \begin{tikzpicture}
    \useasboundingbox (-#1/2-1pt,-#1/2-1pt) rectangle (#1/2+1pt,#1/2+1pt);
    \begin{scope}\clip (0,0) circle (#1/2);
      \node at (0,0) {\includegraphics[scale=\hepcv@cl@scale]{#2}};
    \end{scope}
    \draw[cvaccent,line width=0.9pt] (0,0) circle (#1/2);
  \end{tikzpicture}}
\newcommand*\hepcv@cl@tag[1]{%
  \begin{tikzpicture}[baseline=(t.base)]
    \node[draw=cvtagline,fill=cvtagfill,rounded corners=2pt,inner xsep=4.2pt,inner ysep=1.6pt,
      line width=0.35pt,text=cvgrey,font=\footnotesize,text height=1.55ex,text depth=0.35ex] (t) {#1};
  \end{tikzpicture}}
\ExplSyntaxOn
\NewDocumentCommand \cvtag { m }
  { \bool_if:NTF \g_hepcv_ats_bool {#1} { \hepcv@cl@tag {#1} } }
\cs_set_protected:Npn \hepcv_theme_header:
  {
    \begingroup
    \tl_if_empty:NTF \g_hepcv_photo_tl
      { \dim_set:Nn \l_tmpa_dim { \linewidth } }
      { \dim_set:Nn \l_tmpa_dim { \linewidth - \g_hepcv_photosize_tl - 7mm } }
    \noindent
    \hbox_to_wd:nn { \linewidth }
      {
        \vtop
          {
            \hsize = \l_tmpa_dim \raggedright \noindent
            {\fontsize{27}{31}\selectfont\color{cvaccent} \hepcv_cl_name: \par}
            \skip_vertical:n { 3pt }
            {\fontsize{12.5}{16}\selectfont\cvmedium\color{cvaccent} \tl_use:N \g_hepcv_role_tl \par}
            \skip_vertical:n { 7pt }
            \noindent {\small\color{cvtext} \tl_use:N \g_hepcv_contact_tl \par}
          }
        \hfil
        \tl_if_empty:NF \g_hepcv_photo_tl
          { \vtop { \hbox { \exp_args:NVV \hepcv@cl@photo \g_hepcv_photosize_tl \g_hepcv_photo_tl } } }
      }
    \endgroup
    \par \skip_vertical:n { 2pt }
  }

%% contact items: icon (or label) + value; items flow and wrap
\cs_set_protected:Npn \hepcv_contact_item:nn #1#2
  {
    \bool_if:NTF \l_hepcv_first_bool { \bool_set_false:N \l_hepcv_first_bool }
      { \hspace { 1.05em plus 0.4em } \penalty 0 }
    \mbox
      {
        \bool_if:NTF \g_hepcv_icons_bool
          { \hepcv_cl_icon:n { \hepcv_cl_contact_icon:n {#1} } \hspace { 0.45em } }
          { \tl_if_blank:nF {#1} { \textcolor{cvgrey}{#1:} \nobreakspace } }
        #2
      }
  }

%% ---------------------------------------------------------------- sections
\cs_set_protected:Npn \hepcv_theme_section:n #1
  {
    \skip_vertical:n { \l_hepcv_secbefore_dim }
    \noindent
    {
      \color{cvaccent} \fontsize{13.5}{16}\selectfont \addfontfeatures{LetterSpace=3.5}
      \bool_if:NT \g_hepcv_icons_bool { \makebox [ 1.55em ] [ l ] { \hepcv_cl_secicon:n {#1} } }
      \textsc{#1} \par
    }
    \nobreak \skip_vertical:n { 2.2pt }
    \noindent {\color{cvrule}\rule{\linewidth}{0.45pt}}\par\nobreak
    \skip_vertical:n { \l_hepcv_secafter_dim }
    \nobreak
  }
\cs_set_protected:Npn \hepcv_theme_subsection:n #1
  {
    \skip_vertical:n { 6pt } \nobreak
    \noindent
    \bool_if:NF \g_hepcv_ats_bool { \hspace* { \l__hepcv_cl_indent_dim } }
    {\cvmedium\color{cvaccent}\textsc{#1} \par}
    \nobreak \skip_vertical:n { 1.5pt } \nobreak
  }

%% ---------------------------------------------------------------- bullets (ats mode and plain lists)
\setlist[cvlist]{ leftmargin = 1.15em , labelsep = 0.4em , itemsep = \dim_use:N \l_hepcv_itemsep_dim , topsep = 0pt , partopsep = 0pt , parsep = 0pt }
\bool_if:NTF \g_hepcv_icons_bool
  { \setlist[cvlist,1]{ label = { \hepcv_cl_icon:n { \footnotesize\faAngleRight } } } }
  { \setlist[cvlist,1]{ label = { \textcolor{cvaccent}{\textbullet} } } }
\setlist[cvlist,2]{ label = {\textcolor{cvaccent}{\textendash}} }

%% ---------------------------------------------------------------- entries, lines, skills
%% Non-ATS entries are a stack of ROWS (heading row with the date gutter, one row per bullet, a tag row), each
%% row a small unbreakable box carrying its own piece of the vertical rule.  Rows are collected in a vbox and
%% unboxed into the page, so a long entry breaks between rows (never inside one), the heading stays with the
%% first bullet, and the last two rows stay together.  Rule pieces overlap the gaps, so the rule looks continuous.
\cs_new_eq:NN \hepcv_cl_coreentry:nnnnn \hepcv_entry:nnnnn
\box_new:N \l__hepcv_cl_entry_box
\box_new:N \l__hepcv_cl_new_box
\box_new:N \l__hepcv_cl_pend_box
\box_new:N \l__hepcv_cl_date_box
\box_new:N \l__hepcv_cl_tmp_box
\bool_new:N \l__hepcv_cl_have_bool
\bool_new:N \l__hepcv_cl_head_bool
\bool_new:N \l__hepcv_cl_inentry_bool
\bool_new:N \l__hepcv_cl_rowopen_bool
\int_new:N \l__hepcv_cl_n_int
\dim_new:N \l__hepcv_cl_lastg_dim
\dim_new:N \l__hepcv_cl_dp_dim
\dim_new:N \l__hepcv_cl_tmp_dim
\tl_new:N \l__hepcv_cl_kwcopy_tl
\cs_new_protected:Npn \hepcv_cl_emit:n #1
  {
    \dim_set:Nn \l__hepcv_cl_dp_dim { \box_dp:N \l__hepcv_cl_pend_box }
    \dim_set:Nn \l__hepcv_cl_tmp_dim { \box_ht:N \l__hepcv_cl_pend_box }
    \bool_if:NT \l__hepcv_cl_head_bool
      {
        \dim_set:Nn \l__hepcv_cl_dp_dim { \dim_max:nn { \l__hepcv_cl_dp_dim } { \box_dp:N \l__hepcv_cl_date_box } }
        \dim_set:Nn \l__hepcv_cl_tmp_dim { \dim_max:nn { \l__hepcv_cl_tmp_dim } { \box_ht:N \l__hepcv_cl_date_box } }
      }
    \hbox_set_to_wd:Nnn \l__hepcv_cl_tmp_box { \linewidth }
      {
        \bool_if:NTF \l__hepcv_cl_head_bool { \box_use_drop:N \l__hepcv_cl_date_box } { \hbox_to_wd:nn { \l_hepcv_gutter_dim } { } }
        \hspace { \l_hepcv_gutgap_dim }
        {\color{cvrule}\vrule width 0.5pt height \dim_eval:n { \l__hepcv_cl_tmp_dim + 1pt }
          depth \dim_eval:n { \box_dp:N \l__hepcv_cl_pend_box + #1 }}
        \hspace { \l_hepcv_gutgap_dim }
        \box_use_drop:N \l__hepcv_cl_pend_box
        \hfil
      }
    \box_set_dp:Nn \l__hepcv_cl_tmp_box { \l__hepcv_cl_dp_dim }
    \bool_set_false:N \l__hepcv_cl_head_bool
    \nointerlineskip \box_use_drop:N \l__hepcv_cl_tmp_box
  }
%% push the row in \l__hepcv_cl_new_box, separated from the previous row by #1, break penalty #2 before it
\cs_new_protected:Npn \hepcv_cl_push:nn #1#2
  {
    \bool_if:NT \l__hepcv_cl_have_bool
      {
        \hepcv_cl_emit:n {#1}
        \penalty #2 \skip_vertical:n {#1}
        \dim_set:Nn \l__hepcv_cl_lastg_dim {#1}
      }
    \box_set_eq_drop:NN \l__hepcv_cl_pend_box \l__hepcv_cl_new_box
    \bool_set_true:N \l__hepcv_cl_have_bool
    \int_incr:N \l__hepcv_cl_n_int
  }
\cs_new_protected:Npn \hepcv_cl_flush:
  {
    \bool_if:NT \l__hepcv_cl_have_bool
      {
        \int_compare:nT { \l__hepcv_cl_n_int > 1 }
          { \tex_unskip:D \tex_unpenalty:D \penalty 10000 \skip_vertical:n { \l__hepcv_cl_lastg_dim } }
        \hepcv_cl_emit:n { \l_hepcv_entrysep_dim - 2.5pt }
      }
    \bool_set_false:N \l__hepcv_cl_have_bool
  }
%% a row = vtop of body width; #1 = label (may be empty)
\cs_new_protected:Npn \hepcv_cl_openrow:n #1
  {
    \tex_setbox:D \l__hepcv_cl_new_box \tex_vtop:D \c_group_begin_token
      \hsize = \l__hepcv_cl_bodyw_dim \linewidth = \hsize \parindent = 0pt
      \tl_if_blank:nTF {#1}
        { \noindent \strut }
        {
          \leftskip = 1.15em \noindent
          \hbox_to_wd:nn { 0pt } { \hspace* { -1.15em } \hbox_to_wd:nn { 1.15em } { #1 \hss } \hss }
          \strut
        }
    \bool_set_true:N \l__hepcv_cl_rowopen_bool
  }
\cs_new_protected:Npn \hepcv_cl_closerow:n #1   % #1 = gap before this row
  {
    \bool_if:NT \l__hepcv_cl_rowopen_bool
      {
        \strut \par
        \c_group_end_token
        \bool_set_false:N \l__hepcv_cl_rowopen_bool
        \hepcv_cl_push:nn { #1 } { \int_compare:nTF { \l__hepcv_cl_n_int < 2 } { 10000 } { 0 } }
      }
  }
\cs_new_eq:NN \hepcv_cl_olditem: \item
\cs_new_protected:Npn \hepcv_cl_item:
  {
    \int_compare:nTF { \@listdepth > 0 }
      { \hepcv_cl_olditem: }
      {
        \hepcv_cl_closerow:n { \l_hepcv_itemsep_dim }
        \hepcv_cl_openrow:n
          { \bool_if:NTF \g_hepcv_icons_bool { \hepcv_cl_icon:n { \footnotesize\faAngleRight } } { \textcolor{cvaccent}{\textbullet} } }
      }
  }
\cs_new_protected:Npn \hepcv_cl_bullets:n #1
  {
    %% no group here: the row state lives in the entry vbox group, so assignments must not be undone
    \cs_set_eq:NN \item \hepcv_cl_item:
    \bool_set_false:N \l__hepcv_cl_rowopen_bool
    #1
    \hepcv_cl_closerow:n { \l_hepcv_itemsep_dim }
  }
\cs_new_eq:NN \hepcv_cl_corebullets:n \cvbullets
\RenewDocumentCommand \cvbullets { +m }
  {
    \bool_if:NTF \l__hepcv_cl_inentry_bool
      { \hepcv_cl_bullets:n {#1} }
      { \begin{cvlist} #1 \end{cvlist} }
  }
\cs_new_protected:Npn \hepcv_cl_textrow:n #1
  {
    \hepcv_cl_openrow:n { }
    #1
    \hepcv_cl_closerow:n { 3pt }
  }
%% tag rows: for the linear (ATS) build a plain keyword line; otherwise the tag paragraph is appended to the last
%% pending row, so a page break can never strand the tags (or leave a lone bullet) on their own
\cs_new_protected:Npn \hepcv_cl_tags:n #1
  {
    \tl_if_blank:nF {#1}
      {
        \bool_if:NTF \g_hepcv_ats_bool
          { \par \nobreak {\small\itshape\color{cvgrey} Keywords:~ \clist_use:nn {#1} { ;~ } } \par }
          {
            \vbox_set_top:Nn \l__hepcv_cl_tmp_box
              {
                \hsize = \l__hepcv_cl_bodyw_dim \linewidth = \hsize \parindent = 0pt \raggedright
                \noindent \strut
                \clist_map_inline:nn {#1}
                  { \hepcv@cl@tag { \tl_trim_spaces:n {##1} } \hspace { 2.6pt } \penalty 0 \hspace { 0pt plus 1pt } }
                \par
              }
            \tex_setbox:D \l__hepcv_cl_pend_box \tex_vtop:D \c_group_begin_token
              \vbox_unpack_drop:N \l__hepcv_cl_pend_box
              \nointerlineskip \skip_vertical:n { 3pt } \nointerlineskip
              \box_use_drop:N \l__hepcv_cl_tmp_box
            \c_group_end_token
          }
      }
  }
\cs_generate_variant:Nn \hepcv_cl_tags:n { V }
\bool_if:NTF \g_hepcv_ats_bool
  {
    %% linear fallback: the core layout plus a plain keyword line
    \cs_set_protected:Npn \hepcv_entry:nnnnn #1#2#3#4#5
      { \hepcv_cl_coreentry:nnnnn {#1} {#2} {#3} {#4} {#5} \hepcv_cl_tags:V \l_hepcv_kw_tl }
  }
  {
    \cs_set_protected:Npn \hepcv_entry:nnnnn #1#2#3#4#5
      {
        \bool_lazy_all:nF { { \tl_if_blank_p:n {#1} } { \tl_if_blank_p:n {#2} } { \tl_if_blank_p:n {#3} } { \tl_if_blank_p:n {#4} } { \tl_if_blank_p:n {#5} } }
          {
            \par \hepcv_needspace:n { 4 \baselineskip } \hepcv_gap:n { \l_hepcv_entrysep_dim }
            \tl_set_eq:NN \l__hepcv_cl_kwcopy_tl \l_hepcv_kw_tl
            \vbox_set:Nn \l__hepcv_cl_entry_box
              {
                \hsize = \linewidth \parindent = 0pt \parskip = 0pt
                \bool_set_false:N \l__hepcv_cl_have_bool
                \bool_set_true:N \l__hepcv_cl_inentry_bool
                \vbox_set_top:Nn \l__hepcv_cl_date_box
                  {
                    \hsize = \l_hepcv_gutter_dim \linewidth = \hsize \parindent = 0pt \raggedleft
                    \noindent \hepcv_actual:nn { } { \strut {\cvmedium\color{cvtext}\mbox{#3}} \strut } \par
                    \tl_if_blank:nF {#4}
                      { \nobreak \noindent \hepcv_actual:nn { } { \strut {\small\itshape\color{cvgrey} #4} \strut } \par }
                  }
                \vbox_set_top:Nn \l__hepcv_cl_new_box
                  {
                    \hsize = \l__hepcv_cl_bodyw_dim \linewidth = \hsize \parindent = 0pt \raggedright
                    \tl_if_blank:nF {#1}
                      {
                        \noindent \hepcv_actualx:nn { \exp_not:n {#1} \tl_if_blank:nF {#3} { ,~ \exp_not:n {#3} } }
                          { \strut {\bfseries\color{cvtext}#1} \strut } \par
                      }
                    \bool_lazy_and:nnT { \tl_if_blank_p:n {#1} } { \tl_if_blank_p:n {#2} } { \noindent \strut \par }
                    \tl_if_blank:nF {#2}
                      {
                        \nobreak \noindent
                        \hepcv_actualx:nn { \exp_not:n {#2} \tl_if_blank:nF {#4} { ,~ \exp_not:n {#4} } }
                          { \strut {\cvmedium\small\color{cvaccent}#2} \strut } \par
                      }
                  }
                \bool_set_true:N \l__hepcv_cl_head_bool
                \bool_set_true:N \l__hepcv_cl_have_bool
                \box_set_eq_drop:NN \l__hepcv_cl_pend_box \l__hepcv_cl_new_box
                \int_set:Nn \l__hepcv_cl_n_int { 1 }
                \tl_if_blank:nF {#5}
                  { \tl_if_in:nnTF {#5} { \cvbullets } {#5} { \hepcv_cl_textrow:n {#5} } }
                \hepcv_cl_tags:V \l__hepcv_cl_kwcopy_tl
                \hepcv_cl_flush:
              }
            \nointerlineskip \vbox_unpack_drop:N \l__hepcv_cl_entry_box
          }
      }
    \cs_set_protected:Npn \hepcv_line:nnn #1#2#3
      {
        \par \hepcv_gap:n { \l_hepcv_linesep_dim } \nointerlineskip
        \hbox_to_wd:nn { \linewidth }
          {
            \parbox [ t ] { \l_hepcv_gutter_dim } { \raggedleft \strut {\cvmedium\color{cvaccent}#2} \strut }
            \hspace { \dim_eval:n { 2 \l_hepcv_gutgap_dim + 0.5pt } }
            \parbox [ t ] { \l__hepcv_cl_bodyw_dim } { \raggedright \strut #3 \strut }
            \hfil
          }
        \par
      }
  }

%% ---------------------------------------------------------------- footer: date | name | page, small caps
\fancypagestyle{hepcv}
  {
    \fancyhf{}
    \renewcommand{\headrulewidth}{0pt}
    \renewcommand{\footrulewidth}{0pt}
